<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zp.dao.User2Mapper">

<insert id="insert" parameterType="com.zp.pojo.User2">
    insert into user2 (id, name) values (#{user2.id, user2.name})
</insert>

    <select id="selectByPrimaryKey" resultType="com.zp.pojo.User2">
        select * from user2 u2 where u2.id = #{id}
    </select>




</mapper>