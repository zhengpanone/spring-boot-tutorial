### 签到系统 API 测试套件
### 生成时间: {{$datetime iso8601}}

@baseUrl = http://localhost:8080
@userId = test_user_001
@testDate = 2025-12-19
@yesterdayDate = 2025-12-18
@tomorrowDate = 2025-12-20

############################################
### 1. 签到功能测试
############################################

### 1.1 正常签到（带日期参数）
POST {{baseUrl}}/sign/{{userId}}?date={{testDate}}
Content-Type: application/json

> {%
    client.test("签到成功", function () {
        client.assert(response.status === 200, "状态码应为 200");
        client.assert(response.body === "签到成功", response.body);
    });
%}

### 1.2 重复签到（应该失败）
POST {{baseUrl}}/sign/{{userId}}?date={{testDate}}
Content-Type: application/json

> {%
    client.test("重复签到失败", function () {
        client.assert(response.body.includes("失败"), response.body);
    });
%}

### 1.3 无日期参数签到（当天）
POST {{baseUrl}}/sign/{{userId}}
Content-Type: application/json

> {%
    client.test("无日期参数签到", function () {
        client.assert(response.status === 200);
    });
%}

############################################
### 2. 补签功能
############################################

### 2.1 补签昨天
POST {{baseUrl}}/sign/{{userId}}/retroactive?date={{yesterdayDate}}
Content-Type: application/json

> {%
    client.test("补签成功", function () {
        client.assert(response.status === 200);
        client.assert(response.body === "补签成功", response.body);
    });
%}

### 2.2 重复补签
POST {{baseUrl}}/sign/{{userId}}/retroactive?date={{yesterdayDate}}
Content-Type: application/json

> {%
    client.test("重复补签失败", function () {
        client.assert(response.body.includes("失败"), response.body);
    });
%}

############################################
### 3. 签到检查
############################################

### 3.1 已签到日期
GET {{baseUrl}}/sign/{{userId}}/check?date={{testDate}}
Accept: application/json

> {%
    client.test("检查已签到", function () {
        const result = JSON.parse(response.body);
        client.assert(result === true, response.body);
    });
%}

### 3.2 未签到日期
GET {{baseUrl}}/sign/{{userId}}/check?date=2025-01-02
Accept: application/json

> {%
    client.test("检查未签到", function () {
        const result = JSON.parse(response.body);
        client.assert(result === false, response.body);
    });
%}

############################################
### 4. 统计
############################################

### 4.1 当月签到总数
GET {{baseUrl}}/sign/{{userId}}/count?date={{testDate}}
Accept: application/json

> {%
    client.test("签到总数", function () {
        const count = parseInt(response.body, 10);
        client.assert(count >= 0, count);
    });
%}

############################################
### 5. 连续签到
############################################

### 5.1 连续签到天数
GET {{baseUrl}}/sign/{{userId}}/continuous?date={{testDate}}
Accept: application/json

> {%
    client.test("连续签到天数", function () {
        const days = parseInt(response.body, 10);
        client.assert(days >= 0, days);
    });
%}

############################################
### 6. 签到详情
############################################

### 6.1 当月签到详情
GET {{baseUrl}}/sign/{{userId}}/info?date={{testDate}}
Accept: application/json

> {%
    client.test("签到详情", function () {
        const info = JSON.parse(response.body);
        client.assert(Array.isArray(info), "应返回数组");
    });
%}
